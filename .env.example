# Copy to .env.local and fill in real values from Supabase → Settings → API
# Also set these in Cloudflare Workers → Settings → Variables and secrets
# (and Build variables if using Workers Builds).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

