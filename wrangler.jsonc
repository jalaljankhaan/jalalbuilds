{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jalalbuilds",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-18",
  // Apex is the canonical host. www is served by workers/www-redirect.
  "routes": [
    { "pattern": "jnovasystems.com", "custom_domain": true }
  ],
  "compatibility_flags": [
    // Enable Node.js APIs used by Next.js / OpenNext
    "nodejs_compat",
    // Allow fetch() to public origins from the Worker
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match this Worker's "name"
      "service": "jalalbuilds"
    }
  ],
  // Cloudflare Image Resizing for next/image (optional but recommended by OpenNext)
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jalalbuilds-db",
      "database_id": "31ee7d46-3bae-40bd-8960-eb8a4d85a40f",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
